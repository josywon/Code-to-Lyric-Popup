      rows.push({text:'    <article class="lyric-popup" data-cue="'+c.id+'" data-at="'+Number(c.time).toFixed(2)+'">',active,cueId:c.id});
      rows.push({text:'      <header>'+($("sameTitle").checked?$("sharedTitle").value:(c.title||$("sharedTitle").value))+'</header>',active});
      rows.push({text:'      <span class="emoji">'+(c.emoji||$("sharedEmoji").value)+'</span>',active});
      rows.push({text:'      <p class="lyric">'+JSON.stringify(c.lyric)+'</p>',active});
      rows.push({text:"    </article>",active});
    }
    rows.push({text:"  </main>"},{text:"</body>"},{text:"</html>"});
    const box=$("codeBackground");box.replaceChildren();
    rows.forEach((entry,i)=>{const line=document.createElement("div");line.className="code-line"+(entry.active?" executing":"");if(entry.cueId)line.dataset.cueId=entry.cueId;const n=document.createElement("span");n.className="line-number";n.textContent=String(i+1).padStart(2,"0");const code=document.createElement("span");code.className="code-text";code.innerHTML=syntax(entry.text);line.append(n,code);box.append(line)});const activeLine=activeCue?[...box.children].find(line=>line.dataset.cueId&&line.classList.contains("executing")):null;if(activeLine)box.scrollTop=Math.max(0,activeLine.offsetTop-box.clientHeight/2);
