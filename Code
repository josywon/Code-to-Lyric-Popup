<body>
<div class="desktop">
  <div class="wallpaper" id="wallpaper" aria-hidden="true"></div>
  <div class="topbar"><div class="brand"><span class="orb"></span><span>Messenger Lyric Player</span></div><div>Retro desktop · local mode</div></div>
  <main class="workspace">
    <section class="window" aria-label="Player controls">
      <div class="titlebar"><span>♫ Lyric Popup Studio</span><span class="winbuttons" aria-hidden="true"><span>_</span><span>□</span><span>×</span></span></div>
      <div class="scroll">
        <section class="section">
          <h2>Song player</h2>
          <div class="file-row"><label class="file-label" for="audioFile">Choose MP3 / WAV</label><input id="audioFile" type="file" accept=".mp3,.wav,audio/mpeg,audio/wav,audio/x-wav"><span class="file-name" id="fileName">No song loaded</span></div>
          <div class="transport"><button class="button" id="play" aria-label="Play">▶</button><button class="button secondary" id="stop" aria-label="Stop and rewind">■</button><input type="range" id="seek" min="0" max="100" value="0" aria-label="Seek song"><span class="timecode" id="time">00:00 / 00:00</span></div>
          <div class="range-row"><span>Volume</span><input type="range" id="volume" min="0" max="1" step=".01" value=".8"><span id="volumeText">80%</span></div><audio id="audio" preload="metadata"></audio>
        </section>
        <section class="section">
          <h2>Popup look & timing</h2>
