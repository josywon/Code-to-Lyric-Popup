    $("play").textContent=audio.paused?"▶":"Ⅱ";$("play").setAttribute("aria-label",audio.paused?"Play":"Pause");
  function updateTransport(){
    const r=range(),t=audio.currentTime||0,loaded=Number.isFinite(audio.duration);
    $("seek").min=loaded?r.start:0;$("seek").max=loaded&&r.valid?r.end:100;$("seek").value=String(loaded?Math.min(Math.max(t,r.start),r.valid?r.end:r.start):0);
