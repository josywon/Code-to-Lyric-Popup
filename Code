  function backgroundCue(cue) {
    if(!cue||cue.id===state.bgId)return;state.bgId=cue.id;
    let old=[];try{old=JSON.parse($("wallpaper").dataset.lines||"[]")}catch{}
    old.push("♪ "+cue.lyric);old=old.slice(-8);$("wallpaper").dataset.lines=JSON.stringify(old);
    const base=$("backgroundText").value.trim().split(/\r?\n/).filter(Boolean);
    const out=[];for(let i=0;i<Math.max(base.length,old.length);i++){if(base.length)out.push(base[i%base.length]);if(old[i])out.push(old[i])}
    $("wallpaper").textContent=out.join("\n");
  function applyFade(){

    const r=range(),t=audio.currentTime,fi=Math.max(0,Number($("fadeIn").value)||0),fo=Math.max(0,Number($("fadeOut").value)||0);let f=1;
    if(fi&&t<r.start+fi)f=Math.min(f,Math.max(0,(t-r.start)/fi));
