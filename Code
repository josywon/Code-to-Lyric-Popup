    audio.volume=Math.max(0,Math.min(1,Number($("volume").value)*f));
  }
  function updateHighlight(id) {$("cueList").querySelectorAll(".cue-row").forEach(r=>r.classList.toggle("active",r.dataset.id===id))}
  function updateTransport() {
    const d=Number.isFinite(audio.duration)?audio.duration:0,t=audio.currentTime||0;
    $("seek").max=String(d||100);$("seek").value=String(Math.min(t,d||100));
