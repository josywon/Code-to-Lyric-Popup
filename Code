  $("emojiPickerClose").addEventListener("click",closeEmojiPicker);$("emojiPickerBackdrop").addEventListener("click",e=>{if(e.target===$("emojiPickerBackdrop"))closeEmojiPicker()});$("emojiUseDefault").addEventListener("click",()=>{if(emojiPickerCallback)emojiPickerCallback("");closeEmojiPicker()});$("emojiResults").addEventListener("click",e=>{const option=e.target.closest(".emoji-option");if(!option)return;if(emojiPickerCallback)emojiPickerCallback(option.dataset.emoji);closeEmojiPicker()});
