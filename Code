    const rows=[{text:"<!doctype html>"},{text:'<html lang="en" data-theme="dark">'},{text:"<head>"},{text:'  <title>Messenger Lyric Popups</title>'},{text:"</head>"},{text:'<body class="lyric-showcase">'},{text:'  <main class="stage" data-mode="showcase">'},{text:'    <audio id="song" data-file="'+name+'" data-playing="'+playing+'" data-start="'+r.start.toFixed(2)+'" data-end="'+(Number.isFinite(r.end)?r.end.toFixed(2):"file-end")+'" data-fade-in="'+Number($("fadeIn").value||0).toFixed(2)+'" data-fade-out="'+Number($("fadeOut").value||0).toFixed(2)+'"></audio>',active:playing}];
