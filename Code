  let editorDrag=null;
  const editor=$("editor"),editorTitle=editor.querySelector(".editor-title");
  editorTitle.addEventListener("pointerdown",e=>{if(e.button!==0)return;const r=editor.getBoundingClientRect();editorDrag={x:e.clientX,y:e.clientY,left:r.left,top:r.top};editorTitle.setPointerCapture(e.pointerId);e.preventDefault()});
