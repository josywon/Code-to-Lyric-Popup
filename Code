  }
  $("loadLines").addEventListener("click",parseLines);$("add").addEventListener("click",addCue);
  $("sameTitle").addEventListener("change",()=>{render();refresh()});
  $("sharedTitle").addEventListener("input",refresh);$("duration").addEventListener("input",refresh);$("offset").addEventListener("input",refresh);
