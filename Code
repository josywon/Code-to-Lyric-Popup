    $("play").textContent=audio.paused?"▶":"Ⅱ";$("play").setAttribute("aria-label",audio.paused?"Play selected range":"Pause");
  }
  function refresh() {
    const cue=currentCue(), cid=cue?cue.id:null;
    if(cid!==state.active){state.active=cid;state.dismissed=null;if(cue)backgroundCue(cue)}
    updateHighlight(cid);
  function refresh(){
    const r=range(),cue=currentCue(),cid=cue?cue.id:null,playing=!audio.paused;
    if(cid!==state.active){state.active=cid;state.dismissed=null;codeChanged()}
